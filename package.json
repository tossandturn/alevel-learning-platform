    "test:performance": "node scripts/test-performance-budget.mjs",
    "test:marking-pilot": "node scripts/test-reviewed-marking-pilot.mjs",
    "test:student-navigation": "node scripts/test-student-navigation.mjs",
    "test:paper-study-mode": "node scripts/test-paper-study-mode.mjs",
    "test:topic-learning-content": "node scripts/test-topic-learning-content.mjs",
    "qa:paper-study": "node scripts/qa-paper-study-mode.cjs",
    "build": "npm run questions:audit && npm run papers:audit && npm run test:question-inventory && npm run questions:runtime-catalog && vite build",
    "lint": "oxlint",
    "test": "node scripts/smoke.mjs && node scripts/test-ai-source-images.mjs && node scripts/test-ai-coach.mjs && node scripts/test-paper-study-mode.mjs && node scripts/test-topic-learning-content.mjs && node scripts/test-paper-catalog-governance.mjs && node scripts/test-source-identity.mjs && node scripts/test-syllabus-practice.mjs",
    "test:ai-source-images": "node scripts/test-ai-source-images.mjs",
    "test:ai-coach": "node scripts/test-ai-coach.mjs",
