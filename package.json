    "questions:source-completeness": "node scripts/audit-question-bank.mjs --write-report",
    "questions:runtime-catalog": "node scripts/generate-verified-practice-catalog.mjs",
    "questions:write-runtime-catalog": "node scripts/generate-verified-practice-catalog.mjs --write",
    "questions:inventory": "node scripts/question-inventory-matrix.mjs",
    "questions:syllabus-candidates": "node scripts/generate-syllabus-mapping-candidates.mjs",
    "test:question-inventory": "node scripts/test-question-inventory.mjs",
    "test:syllabus": "node scripts/test-syllabus-practice.mjs",
    "questions:coverage": "node scripts/question-coverage-matrix.mjs",
