{
  "name": "alevel-learning-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "catalog": "node scripts/generate-paper-catalog.mjs",
    "questions:index": "node scripts/import-question-index.mjs",
    "questions:audit": "node scripts/audit-question-bank.mjs",
    "questions:source-manifest": "node scripts/audit-question-bank.mjs --write-manifest",
    "questions:source-completeness": "node scripts/audit-question-bank.mjs --write-report",
    "questions:coverage": "node scripts/question-coverage-matrix.mjs",
    "test:source-identity": "node scripts/test-source-identity.mjs",
    "test:marking-pilot": "node scripts/test-reviewed-marking-pilot.mjs",
    "build": "npm run questions:audit && vite build",
    "lint": "oxlint",
    "test": "node scripts/smoke.mjs && node scripts/test-ai-source-images.mjs && node scripts/test-source-identity.mjs",
    "test:ai-source-images": "node scripts/test-ai-source-images.mjs",
    "test:shared-workspace": "node scripts/test-shared-workspace.mjs",
    "qa:browser": "node scripts/qa-source-gate.cjs",
    "qa:coach": "node scripts/qa-coach-generated.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
