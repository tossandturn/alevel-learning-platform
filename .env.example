# Qwen / DashScope configuration. Keep real values in .env only.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=Singapore
DASHSCOPE_COMPAT_BASE_URL=

# Server-only OpenAI configuration for Coach and local AI PDF ingestion. Never expose in browser code.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_BASE_URL=
OPENAI_MODEL=gpt-5.6
OPENAI_COACH_MODEL=
OPENAI_VISION_MODEL=
AI_PDF_INGESTION_MODEL=gpt-5.6
AI_PDF_INGESTION_CONCURRENCY=
AI_PDF_INGESTION_ROOT=./data/ai-pdf-ingestion

# Coach uses Qwen by default, even when an OpenAI key is configured. Set
# AI_PROVIDER=openai only to opt in to OpenAI routing; it falls back to Qwen
# when Qwen is configured.
AI_PROVIDER=
COACH_AI_MODEL=qwen3.7-max
COACH_AI_BASE_URL=
COACH_AI_API_KEY=

VISION_AI_MODEL=qwen3-vl-plus
VISION_AI_BASE_URL=
VISION_AI_API_KEY=

# Bound each provider attempt and the complete fallback chain.
# Values are server-only milliseconds.
STEM_AI_PROVIDER_TIMEOUT_MS=25000
STEM_AI_REQUEST_DEADLINE_MS=50000
# Vision models can take longer to inspect a photographed question before
# emitting their first token. These remain bounded below the proxy deadline.
STEM_AI_VISION_PROVIDER_TIMEOUT_MS=45000
STEM_AI_VISION_REQUEST_DEADLINE_MS=55000

# Server-only shared authentication key. Configure the same value on the
# STEM and IELTSist servers; it is never exposed to the browser.
STEM_INTERNAL_AUTH_KEY=
# Legacy fallback for existing installations. Prefer STEM_INTERNAL_AUTH_KEY.
STEM_IDENTITY_SIGNING_KEY=
# Loopback-only internal account verifier. Browser traffic stays on STEM.
STEM_AUTH_INTERNAL_ORIGIN=http://127.0.0.1:4321
# Stable shared data location in production. STEM_DB_PATH is retained as a
# backwards-compatible fallback.
STEM_DATABASE_PATH=
STEM_DB_PATH=./data/stem.sqlite
