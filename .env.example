# Qwen / DashScope configuration. Keep real values in .env only.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=Singapore
DASHSCOPE_COMPAT_BASE_URL=

COACH_AI_MODEL=qwen3.7-max
COACH_AI_BASE_URL=
COACH_AI_API_KEY=

VISION_AI_MODEL=qwen3-vl-plus
VISION_AI_BASE_URL=
VISION_AI_API_KEY=

# Must match the private STEM_IDENTITY_SIGNING_KEY configured for IELTS-ist.
# The browser never receives this value; STEM uses it only to verify a five-minute handoff token.
STEM_IDENTITY_SIGNING_KEY=
STEM_DB_PATH=./data/stem.sqlite
